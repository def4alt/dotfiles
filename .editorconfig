root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,lua,sh,toml}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[{home/gitconfig,home/gitignore}]
indent_style = tab

[{home/ssh_config}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
