# Managed by mise: https://github.com/def4alt/dotfiles

# OrbStack requires this before any Host blocks.
Include ~/.orbstack/ssh/config

Host halle
  Hostname lxhalle.in.tum.de
  User olkh

Host zorya
  HostName 100.75.144.2
  User def4alt

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  # One connection per host instead of a handshake per command: agent-driven
  # git-over-ssh runs dozens of short-lived ssh calls. %C is the short hashed
  # path OpenSSH derives, so the socket path stays under the 104-byte limit.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  ServerAliveInterval 30
  ServerAliveCountMax 3
